{
  "_comment": "MRG-VM v2 -- adaptive reliability-conditioned spatial-temporal architecture with corruption augmentation. Reliability is learned from the five MRS sub-scores, a learnable conditioner modulates the temporal stream, fusion is cross-attention over sequences, the loss is ordinal, and the training split is augmented with corrupted variants so reliability actually varies during training.",
  "vision_mamba": {
    "image_size": 112,
    "patch_size": 16,
    "d_model": 128,
    "spatial_depth": 2,
    "temporal_depth": 2,
    "d_state": 16,
    "dropout": 0.1,
    "max_frames": 64,
    "guide_delta": false,
    "guide_pooling": true,
    "min_delta_scale": 0.25,
    "delta_map": "linear"
  },
  "reliability": {
    "learn_weights": true,
    "adaptive_conditioning": true,
    "hidden_dim": 32,
    "min_dt_scale": 0.1,
    "dropout": 0.0,
    "use_film": true,
    "use_gate": true,
    "use_dt": true,
    "loss_weighting": true,
    "loss_weight_strength": 1.0,
    "loss_weight_floor": 0.25
  },
  "fusion": {
    "kind": "cross_attention",
    "num_heads": 4,
    "hidden_dim": 128,
    "dropout": 0.2,
    "use_mamba": true,
    "use_geometric": true,
    "geometric_pooling": "stats"
  },
  "classifier": {
    "hidden_dims": [
      128,
      64
    ],
    "dropout": 0.3,
    "num_classes": 4
  },
  "data": {
    "max_frames": 50,
    "target": "Engagement",
    "num_classes": 4,
    "batch_size": 4,
    "num_workers": 0,
    "standardize": true,
    "use_mrs_gate": true,
    "include_gaze_features": true,
    "corruption_augment": 2
  },
  "train": {
    "epochs": 40,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "warmup_epochs": 3,
    "grad_clip": 1.0,
    "early_stopping_patience": 10,
    "label_smoothing": 0.05,
    "class_weighting": true,
    "loss": "coral",
    "seed": 42,
    "deterministic": true
  },
  "splits": [
    "Train",
    "Validation",
    "Test"
  ]
}